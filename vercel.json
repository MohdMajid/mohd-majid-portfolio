{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": ["frontend/**", "admin/**"]
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.js" },
    { "source": "/admin/:path*", "destination": "/api/index.js" },
    { "source": "/:path*", "destination": "/api/index.js" }
  ]
}
